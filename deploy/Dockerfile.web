FROM node:22-alpine AS build

ARG APP_VERSION=""
ARG GIT_SHA=""

WORKDIR /build

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages packages
COPY apps/web apps/web

RUN pnpm install --frozen-lockfile --store-dir /build/.pnpm-store
RUN pnpm --filter @scraper/web build --mode production

FROM nginx:alpine

ARG APP_VERSION=""
ARG GIT_SHA=""

RUN addgroup -g 10001 -S scraper && adduser -u 10001 -S scraper -G scraper

COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh && \
    mkdir -p /usr/share/nginx/html && \
    chown -R scraper:scraper /var/log/nginx /var/cache/nginx /usr/share/nginx/html /entrypoint.sh && \
    touch /var/run/nginx.pid && chown scraper:scraper /var/run/nginx.pid

COPY --from=build --chown=scraper:scraper /build/apps/web/dist /usr/share/nginx/html

ENV APP_VERSION=$APP_VERSION \
    GIT_SHA=$GIT_SHA \
    API_URL=/api/v1 \
    APP_TITLE=Scraper \
    DEFAULT_LOCALE=en

USER scraper

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:80/health || exit 1

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
