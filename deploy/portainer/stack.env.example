GH_ORG=your-org
IMAGE_TAG=v0.1.0
APP_VERSION=0.1.0
GIT_SHA=a1b2c3d

APP_URL=https://scraper.example.com
WEB_PORT=8080

POSTGRES_USER=scraper
POSTGRES_DB=scraper
POSTGRES_PASSWORD=
DATABASE_URL=postgres://scraper:SAME_AS_POSTGRES_PASSWORD@postgres:5432/scraper
REDIS_URL=redis://redis:6379/0

ENCRYPTION_KEY=
SESSION_SECRET=
BROWSER_TOKEN=

MAIL_FROM=Scraper <alerts@example.com>
MAIL_DRIVER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=
SMTP_SECURE=false

RUN_MIGRATIONS_ON_BOOT=true
ENABLE_REGISTRATION=true
WORKER_REPLICAS=1
LOG_LEVEL=info
METRICS_ENABLED=true
