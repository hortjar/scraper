# Portainer stack variables for scraper.
#
# Paste into Portainer -> Stacks -> your stack -> Environment variables (Advanced mode).
#
# Two things to know before you edit:
#
#  1. Only names listed in the `x-app-environment` anchor of deploy/docker-compose.yml
#     reach the containers. Adding a variable here that is not in that anchor does
#     nothing. STACK.md lists the ones that do not.
#  2. Leave an optional variable OUT rather than setting it empty. Compose omits an
#     unset name entirely so the app's own default applies; an empty string looks
#     configured and overrides that default.
#
# ---- REQUIRED: the stack refuses to start without these --------------------

# No image variables needed. With docker-compose.build.yml as a second compose
# path, the three app images build from the cloned repository and are tagged
# local/scraper-*:dev.
#
# Set these two only to PULL published images instead of building:
# IMAGE_REGISTRY=ghcr.io/your-org
# IMAGE_TAG=v0.5.0

# Public URL of the instance, used for links in notification emails.
APP_URL=https://scraper.example.com

# The connection string is assembled from the POSTGRES_* parts below, so this is
# the only place the password is written. It is percent-encoded on assembly, so a
# `+`, `/` or `=` from `openssl rand -base64 32` is safe.
POSTGRES_PASSWORD=

# openssl rand -base64 32
# ENCRYPTION_KEY is effectively permanent: it encrypts notification channel
# secrets and there is no rotation tooling yet. Changing it orphans them.
ENCRYPTION_KEY=
SESSION_SECRET=

# Any non-empty value; shared with the browserless container.
BROWSER_TOKEN=

# ---- COMMONLY SET ----------------------------------------------------------

# Host port for the web container. It is the only published port; put your own
# reverse proxy in front of it for TLS.
WEB_PORT=8080

# Browser-visible API base. It is written into config.js and read by the user's
# browser, so it must stay a same-origin relative path -- a container hostname
# does not resolve there. Defaults to /api/v1; override only if you know why.
# API_URL=/api/v1

# Defaults match the compose services; change only for an external database.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
POSTGRES_USER=scraper
POSTGRES_DB=scraper

# Redis needs no password on the bundled instance. Set one and the compose file
# wires --requirepass and the healthcheck's -a flag from the same variable.
# REDIS_PASSWORD=
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0

# Escape hatch for a managed Postgres or Redis that issues one connection string.
# An explicit value overrides every part above.
# DATABASE_URL=
# REDIS_URL=

# Turn registration off after you have created your admin user.
ENABLE_REGISTRATION=true

WORKER_REPLICAS=1

# These only feed the version indicator in the UI.
# APP_VERSION=0.5.0
# GIT_SHA=

# ---- MAIL: optional. Unset means email is simply unavailable ---------------
#
# Nothing here is required to boot. With no transport configured the stack starts
# normally and /api/v1/meta reports emailAvailable:false, so the UI hides email
# channels instead of offering a delivery that would silently fail.
#
# To enable it you need MAIL_FROM *and* a transport. Setting one without the other
# leaves email unavailable.

# MAIL_FROM=Scraper <alerts@example.com>
# MAIL_DRIVER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=
# SMTP_SECURE=true

# Or, with MAIL_DRIVER=resend:
# RESEND_API_KEY=

# ---- OPTIONAL: shown with their defaults, delete any line you do not change -

# APP_ENV=production
# LOG_LEVEL=info
# LOG_FORMAT=json
# DEFAULT_LOCALE=en
# SUPPORTED_LOCALES=en,cs

# Leave CORS_ORIGINS unset for the normal same-origin deployment. It exists only
# for serving the frontend from a different domain than the API.
# CORS_ORIGINS=
# TRUST_PROXY=true

# ENABLE_OPENAPI=true
# ENABLE_BULL_BOARD=false

# DATABASE_POOL_MAX=10
# DATABASE_SSL=false
# RUN_MIGRATIONS_ON_BOOT=true

# WORKER_CONCURRENCY=5
# NOTIFY_CONCURRENCY=20

# SESSION_TTL_SECONDS=604800
# RATE_LIMIT_ENABLED=true

# Scraping politeness and limits.
# MIN_SCRAPE_INTERVAL_SECONDS=300
# MAX_MONITORS_PER_USER=100
# SCRAPE_TIMEOUT_MS=30000
# SCRAPE_USER_AGENT=ScraperBot/1.0
# RESPECT_ROBOTS_TXT=true
# DOMAIN_RATE_LIMIT_PER_MINUTE=6
# AUTO_PAUSE_AFTER_FAILURES=20
# BLOCKED_HOST_PATTERNS=

# BROWSER_TIMEOUT_MS=45000
# BROWSER_MAX_CONTEXTS=4
# SCREENSHOTS_ENABLED=true

# STORAGE_DRIVER=local writes to the `snapshots` volume at STORAGE_LOCAL_PATH.
# Do NOT set STORAGE_DRIVER=s3 here: no S3_* credential is forwarded to the
# containers, so the s3 driver cannot be configured from Portainer today.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=/data/snapshots
# RUN_RETENTION_DAYS=90
# SNAPSHOT_RETENTION_DAYS=30

# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=scraper-api
# METRICS_ENABLED=true
# SENTRY_DSN=
