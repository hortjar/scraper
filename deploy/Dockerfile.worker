FROM node:22-bookworm-slim AS build

WORKDIR /build

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages packages
COPY apps/worker apps/worker

RUN pnpm install --frozen-lockfile --prod

COPY deploy/verify-deploy.mjs /verify-deploy.mjs
RUN node /verify-deploy.mjs /build/apps/worker/node_modules/@scraper/server

FROM node:22-bookworm-slim

ARG APP_VERSION=""
ARG GIT_SHA=""

WORKDIR /app

RUN groupadd -g 10001 -r scraper && useradd -u 10001 -r -g scraper scraper

COPY --from=build /build /app

RUN mkdir -p /tmp /data/snapshots && chown -R scraper:scraper /app /tmp /data
RUN date -u +%Y-%m-%dT%H:%M:%SZ > /app/BUILD_AT

ENV APP_VERSION=$APP_VERSION \
    GIT_SHA=$GIT_SHA \
    NODE_ENV=production

USER scraper

WORKDIR /app/apps/worker

CMD ["sh", "-c", "BUILD_AT=$(cat /app/BUILD_AT) exec node_modules/.bin/tsx src/main.ts"]
