FROM node:22-bookworm-slim AS deps

WORKDIR /build

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch --frozen-lockfile --store-dir /build/.pnpm-store

FROM node:22-bookworm-slim AS deploy

WORKDIR /build

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --from=deps /build/.pnpm-store ./.pnpm-store
COPY packages packages
COPY apps/worker apps/worker

RUN pnpm install --frozen-lockfile --store-dir /build/.pnpm-store
RUN pnpm deploy --filter @scraper/worker --prod /app

FROM node:22-bookworm-slim

ARG APP_VERSION=""
ARG GIT_SHA=""

WORKDIR /app

RUN groupadd -g 10001 -r scraper && useradd -u 10001 -r -g scraper scraper

COPY --from=deploy /app .

RUN mkdir -p /tmp /data/snapshots && chown -R scraper:scraper /app /tmp /data

ENV APP_VERSION=$APP_VERSION \
    GIT_SHA=$GIT_SHA \
    NODE_ENV=production

USER scraper

CMD ["node_modules/.bin/tsx", "src/main.ts"]
