# Generated by `pnpm gen:env` from packages/core/src/config/environment-spec.ts
# Edit the spec, not this file.

# ======================================================================
# Core
# ======================================================================

# development | test | production
APP_ENV=production

# Public URL, used in emails, links and origin checks
# required
APP_URL=

# Baked at build time, reported by /health
APP_VERSION=0.0.0-dev

# Baked at build time, shown next to the version
GIT_SHA=local

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# json | pretty
LOG_FORMAT=json

# Fallback locale
DEFAULT_LOCALE=en

# Comma separated locale list
SUPPORTED_LOCALES=en,cs

# ======================================================================
# API
# ======================================================================

# HTTP port
API_PORT=9300

# Bind address
API_HOST=0.0.0.0

# Comma separated. Empty means same origin only
CORS_ORIGINS=

# Read X-Forwarded-For for rate limiting
TRUST_PROXY=true

# Maximum request body size
BODY_LIMIT_BYTES=1048576

# Serve Swagger UI and the OpenAPI document
ENABLE_OPENAPI=true

# Admin queue dashboard
ENABLE_BULL_BOARD=false

# Turn off for a private instance
ENABLE_REGISTRATION=true

# ======================================================================
# Database
# ======================================================================

# Password; the URL is assembled from it
# required
# secret, generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Hostname on the compose network
POSTGRES_HOST=postgres

# Container port, not the published one
POSTGRES_PORT=5432

# Role the app connects as
POSTGRES_USER=scraper

# Database name
POSTGRES_DB=scraper

# Escape hatch: a full connection string overrides the parts above
# secret, generate with: openssl rand -base64 32
DATABASE_URL=

# Connections per process
DATABASE_POOL_MAX=10

# Seconds before an idle connection closes
DATABASE_POOL_IDLE_TIMEOUT=30

# Enable for managed Postgres
DATABASE_SSL=false

# API applies migrations under an advisory lock
RUN_MIGRATIONS_ON_BOOT=true

# ======================================================================
# Redis and queues
# ======================================================================

# Set only if your Redis requires auth
# secret, generate with: openssl rand -base64 32
REDIS_PASSWORD=

# Hostname on the compose network
REDIS_HOST=redis

# Container port, not the published one
REDIS_PORT=6379

# Logical database index
REDIS_DB=0

# Escape hatch: a full connection string overrides the parts above
# secret, generate with: openssl rand -base64 32
REDIS_URL=

# Namespace so environments can share Redis
JOB_PREFIX=scraper

# Simultaneous scrapes per worker replica
WORKER_CONCURRENCY=5

# Simultaneous notification sends
NOTIFY_CONCURRENCY=20

# Retries before a scrape job is abandoned
SCRAPE_MAX_ATTEMPTS=3

# Exponential backoff base
JOB_BACKOFF_BASE_MS=30000

# ======================================================================
# Security
# ======================================================================

# 32 bytes base64, encrypts channel secrets
# required
# secret, generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# 32 bytes base64, signs session cookies
# required
# secret, generate with: openssl rand -base64 32
SESSION_SECRET=

# Sliding session lifetime
SESSION_TTL_SECONDS=604800

# Hard session cap
SESSION_ABSOLUTE_TTL_SECONDS=2592000

# Session cookie name
SESSION_COOKIE_NAME=sid

# Argon2id memory cost
ARGON2_MEMORY_KIB=19456

# Argon2id time cost
ARGON2_TIME_COST=2

# Check passwords against HIBP ranges
PASSWORD_BREACH_CHECK=false

# Enable request rate limiting
RATE_LIMIT_ENABLED=true

# ======================================================================
# Identity
# ======================================================================

# local owns users here | universal delegates to the IdP
AUTH_MODE=local

# Identity provider base URL, required in universal mode
UNIVERSAL_AUTH_URL=

# Expected token issuer, defaults to UNIVERSAL_AUTH_URL
UNIVERSAL_AUTH_ISSUER=

# App slug, the expected token audience
UNIVERSAL_AUTH_APP=scraper

# Key this app presents to the identity provider
# secret, generate with: openssl rand -base64 32
UNIVERSAL_AUTH_API_KEY=

# Bootstrap admin account, local mode only
ADMIN_EMAIL=

# Bootstrap admin password, local mode only
# secret, generate with: openssl rand -base64 32
ADMIN_PASSWORD=

# ======================================================================
# Scraping
# ======================================================================

# Floor for user schedules
MIN_SCRAPE_INTERVAL_SECONDS=300

# Per user monitor cap
MAX_MONITORS_PER_USER=100

# Fair scheduling cap
MAX_CONCURRENT_RUNS_PER_USER=5

# HTTP strategy timeout
SCRAPE_TIMEOUT_MS=30000

# Response body cap
SCRAPE_MAX_BYTES=10485760

# Identify the crawler
SCRAPE_USER_AGENT=ScraperBot/1.0

# Honour robots.txt
RESPECT_ROBOTS_TXT=true

# Allow per monitor robots override
ALLOW_ROBOTS_OVERRIDE=false

# Requests per target host per minute
DOMAIN_RATE_LIMIT_PER_MINUTE=6

# Consecutive failures before auto pause
AUTO_PAUSE_AFTER_FAILURES=20

# Extra SSRF denylist, comma separated
BLOCKED_HOST_PATTERNS=

# ======================================================================
# Browser
# ======================================================================

# ws://browser:3000, empty launches locally
BROWSER_WS_ENDPOINT=

# Appended to BROWSER_WS_ENDPOINT as ?token=. Leave empty when the endpoint already carries one
# secret, generate with: openssl rand -base64 32
BROWSER_TOKEN=

# Browser strategy timeout
BROWSER_TIMEOUT_MS=45000

# Concurrent contexts per worker
BROWSER_MAX_CONTEXTS=4

# Resource types to block
BROWSER_BLOCK_RESOURCES=image,media,font

# Capture screenshots on browser runs
SCREENSHOTS_ENABLED=true

# ======================================================================
# Storage
# ======================================================================

# local | s3
STORAGE_DRIVER=local

# Must be a mounted volume
STORAGE_LOCAL_PATH=/data/snapshots

# S3 compatible endpoint
S3_ENDPOINT=

# Bucket name
S3_BUCKET=

# Bucket region
S3_REGION=

# S3 access key
# secret, generate with: openssl rand -base64 32
S3_ACCESS_KEY_ID=

# S3 secret key
# secret, generate with: openssl rand -base64 32
S3_SECRET_ACCESS_KEY=

# Run history retention
RUN_RETENTION_DAYS=90

# Snapshot retention
SNAPSHOT_RETENTION_DAYS=30

# Screenshot retention
SCREENSHOT_RETENTION_DAYS=14

# ======================================================================
# Email
# ======================================================================

# smtp | resend | console
MAIL_DRIVER=smtp

# Sender address; unset disables email entirely
MAIL_FROM=

# SMTP server host; unset disables email on the smtp driver
SMTP_HOST=

# SMTP server port
SMTP_PORT=587

# SMTP username
SMTP_USER=

# SMTP password
# secret, generate with: openssl rand -base64 32
SMTP_PASSWORD=

# Use TLS
SMTP_SECURE=true

# Resend API key
# secret, generate with: openssl rand -base64 32
RESEND_API_KEY=

# Terminal failures before a channel auto disables
CHANNEL_FAILURE_LIMIT=10

# ======================================================================
# Observability
# ======================================================================

# Empty disables tracing
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name reported to the collector
OTEL_SERVICE_NAME=scraper-api

# Expose /metrics
METRICS_ENABLED=true

# Sentry DSN
# secret, generate with: openssl rand -base64 32
SENTRY_DSN=
