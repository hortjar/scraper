ARG BUN_IMAGE=oven/bun:1.3.10-alpine

FROM node:22-alpine AS build

WORKDIR /build

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages packages
COPY apps/api apps/api

RUN pnpm install --frozen-lockfile --prod

COPY deploy/verify-deploy.mjs /verify-deploy.mjs
RUN node /verify-deploy.mjs /build/apps/api/node_modules/@scraper/server

FROM ${BUN_IMAGE}

ARG APP_VERSION=""
ARG GIT_SHA=""

WORKDIR /app

RUN addgroup -g 10001 -S scraper && adduser -u 10001 -S scraper -G scraper

COPY --from=build /build /app
COPY apps/api/scripts/healthcheck.ts ./healthcheck.ts

RUN mkdir -p /tmp /data/snapshots && chown -R scraper:scraper /app /tmp /data
RUN date -u +%Y-%m-%dT%H:%M:%SZ > /app/BUILD_AT

ENV APP_VERSION=$APP_VERSION \
    GIT_SHA=$GIT_SHA \
    NODE_ENV=production

USER scraper

WORKDIR /app/apps/api

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD bun run /app/healthcheck.ts || exit 1

EXPOSE 9300

CMD ["sh", "-c", "BUILD_AT=$(cat /app/BUILD_AT) exec bun src/main.ts"]
