    "@scraper/db": "workspace:*",
    "effect": "^3.22.0",
    "elysia": "^1.4.0",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@scraper/tooling": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
