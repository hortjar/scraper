{
  "components": {
    "schemas": {}
  },
  "info": {
    "description": "Web scraping and change-monitoring platform API.",
    "title": "Scraper API",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "additionalProperties": false,
                  "properties": {
                    "commit": {
                      "type": "string"
                    },
                    "status": {
                      "enum": ["ok"],
                      "type": "string"
                    },
                    "time": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": ["status", "version", "commit", "time"],
                  "type": "object"
                }
              }
            },
            "description": "Response for status 200"
          }
        },
        "summary": "Liveness probe",
        "tags": ["System"]
      }
    },
    "/meta": {
      "get": {
        "operationId": "getMeta",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "additionalProperties": false,
                  "properties": {
                    "channelKinds": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "defaultLocale": {
                      "type": "string"
                    },
                    "locales": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "registrationOpen": {
                      "type": "boolean"
                    }
                  },
                  "required": ["locales", "defaultLocale", "registrationOpen", "channelKinds"],
                  "type": "object"
                }
              }
            },
            "description": "Response for status 200"
          }
        },
        "summary": "Public runtime metadata",
        "tags": ["System"]
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "string"
                }
              }
            },
            "description": "Response for status 200"
          }
        },
        "summary": "Prometheus metrics",
        "tags": ["System"]
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "additionalProperties": false,
                  "properties": {
                    "checks": {
                      "additionalProperties": false,
                      "properties": {
                        "database": {
                          "type": "boolean"
                        },
                        "redis": {
                          "type": "boolean"
                        }
                      },
                      "required": ["database", "redis"],
                      "type": "object"
                    },
                    "status": {
                      "enum": ["ok", "unhealthy"],
                      "type": "string"
                    },
                    "time": {
                      "type": "string"
                    }
                  },
                  "required": ["status", "checks", "time"],
                  "type": "object"
                }
              }
            },
            "description": "Response for status 200"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "additionalProperties": false,
                  "properties": {
                    "checks": {
                      "additionalProperties": false,
                      "properties": {
                        "database": {
                          "type": "boolean"
                        },
                        "redis": {
                          "type": "boolean"
                        }
                      },
                      "required": ["database", "redis"],
                      "type": "object"
                    },
                    "status": {
                      "enum": ["ok", "unhealthy"],
                      "type": "string"
                    },
                    "time": {
                      "type": "string"
                    }
                  },
                  "required": ["status", "checks", "time"],
                  "type": "object"
                }
              }
            },
            "description": "Response for status 503"
          }
        },
        "summary": "Readiness probe",
        "tags": ["System"]
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
